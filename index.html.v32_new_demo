<script>
(function () {
  var her = document.getElementById('her'); if (!her) return;
  var track = her.querySelector('.her-track');
  var slides = Array.prototype.slice.call(track.children);
  var tabs = Array.prototype.slice.call(her.querySelectorAll('.her-tab'));
  var dotsBox = her.querySelector('.her-dots');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var cur = 0, timer = null;
  slides.forEach(function (_, i) {
    var d = document.createElement('button'); d.type = 'button'; d.className = 'her-dot';
    d.setAttribute('aria-label', 'Task ' + (i + 1) + ' of ' + slides.length);
    d.addEventListener('click', function () { go(i); }); dotsBox.appendChild(d);
  });
  var dots = Array.prototype.slice.call(dotsBox.children);
  function setActive(i) {
    cur = i;
    tabs.forEach(function (t, j) { t.classList.toggle('is-active', j === i); t.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
    dots.forEach(function (d, j) { d.classList.toggle('is-active', j === i); });
    slides.forEach(function (sl, j) {
      Array.prototype.forEach.call(sl.querySelectorAll('video'), function (v) {
        if (j === i) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
        else { v.removeAttribute('autoplay'); v.pause(); }
      });
    });
  }
  function go(i) {
    i = (i + slides.length) % slides.length;
    track.scrollTo({ left: i * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    setActive(i);
  }
  tabs.forEach(function (t) { t.addEventListener('click', function () { go(+t.getAttribute('data-i')); }); });
  Array.prototype.forEach.call(her.querySelectorAll('.her-arrow'), function (b) {
    b.addEventListener('click', function () { go(cur + (+b.getAttribute('data-dir'))); });
  });
  track.addEventListener('scroll', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      var i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== cur && i >= 0 && i < slides.length) setActive(i);
    }, 90);
  });
  track.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight') { go(cur + 1); e.preventDefault(); }
    if (e.key === 'ArrowLeft') { go(cur - 1); e.preventDefault(); }
  });
  window.addEventListener('resize', function () { track.scrollTo({ left: cur * track.clientWidth, behavior: 'auto' }); });
  setActive(0);
})();
(function () {
  var links = Array.prototype.slice.call(document.querySelectorAll('.legend a[data-sec]'));
  if (!links.length) return;
  var secs = links.map(function (l) { return document.getElementById(l.getAttribute('data-sec')); });
  var ticking = false;
  function update() {
    ticking = false;
    var y = window.scrollY + window.innerHeight * 0.35, idx = 0;
    secs.forEach(function (sec, i) { if (sec && sec.offsetTop <= y) idx = i; });
    links.forEach(function (l, i) { l.classList.toggle('is-active', i === idx); });
  }
  window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  window.addEventListener('resize', update);
  update();
})();
</script>

