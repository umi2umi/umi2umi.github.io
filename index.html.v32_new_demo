<title>Hide, Erase, or Replace?</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap">
<style>
/* Layout: UMI-Underwater pattern. Full-height video hero with dark overlay and white type, top link bar, boxed section tabs at the hero foot; then 960px centered sections, one black band for the method taxonomy, rounded 20px media, boxed Q&A, headshot grid, BibTeX, footer credits. Single light theme, committed, like the reference site. */
:root {
  --bg: #ffffff;
  --fg: #363636;
  --fg-muted: #4a4a4a;
  --fg-light: #7a7a7a;
  --band: #0a0a0a;
  --band-fg: #f5f5f5;
  --box: #f5f5f5;
  --line: #dbdbdb;
  --link: hsl(204, 86%, 53%);
  --accent: #ff7a1a;      /* UMI finger orange */
  --dark-btn: #363636;
  --ph-line: #c7792a;
  --ph-bg: #fff7ee;
  --ph-fg: #8a4b0d;
  --font-title: "Google Sans", "Noto Sans", "Helvetica Neue", Arial, sans-serif;
  --font-body: "Noto Sans", "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color-scheme: light;
}
body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 1rem; line-height: 1.6; -webkit-font-smoothing: antialiased; }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--band); }
*, *::before, *::after { box-sizing: border-box; }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
img, video { max-width: 100%; display: block; }
h1, h2, h3 { font-family: var(--font-title); text-wrap: balance; margin: 0; }

/* Hero */
.hero { position: relative; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; background: var(--band); color: #fff; }
.hero-video { position: absolute; inset: 0; z-index: 0; }
.hero-video video { width: 100%; height: 100%; object-fit: cover; }
.overlay { position: absolute; inset: 0; background: rgba(0,0,0,.45); z-index: 1; }
.hero-head, .hero-body, .hero-foot { position: relative; z-index: 2; }
.hero-head { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .25rem; padding-block: .6rem; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); font-size: 1.05rem; }
.hero-head a, .hero-head span.soon { color: #fff; display: inline-flex; align-items: center; gap: .45rem; padding: .5rem 1rem; }
.hero-head a:hover { text-decoration: none; background: rgba(255,255,255,.12); border-radius: 6px; }
.hero-head .soon { opacity: .55; cursor: default; }
.hero-head svg { width: 1.1em; height: 1.1em; fill: currentColor; }
.hero-body { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding-block: 3rem; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.hero-body .container { max-width: 1100px; }
.hero-title { font-size: clamp(2.6rem, 9vw, 7.5rem); font-weight: 700; line-height: 1.02; letter-spacing: -.01em; color: #fff; }
.hero-sub { font-size: clamp(1.25rem, 3.2vw, 2.6rem); font-weight: 600; margin-top: .9rem; color: #fff; line-height: 1.2; }
.hero-venue, .hero-authors, .hero-aff { font-style: italic; opacity: .85; margin-top: 1.1rem; font-family: var(--font-title); }
.hero-venue { font-size: clamp(1.1rem, 2.2vw, 1.9rem); }
.hero-authors { font-size: clamp(1rem, 1.8vw, 1.5rem); line-height: 1.5; }
.hero-authors a { color: inherit; }
.hero-aff { font-size: clamp(.95rem, 1.5vw, 1.2rem); margin-top: .5rem; }
.hero-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin-top: 1.6rem; }
.btn { display: inline-flex; align-items: center; gap: .5rem; background: var(--dark-btn); color: #fff; border-radius: 9999px; padding: .55rem 1.2rem; font-size: 1rem; font-family: var(--font-body); border: 1px solid transparent; }
.btn:hover { text-decoration: none; background: #1f1f1f; }
.btn svg { width: 1em; height: 1em; fill: currentColor; }
.btn.soon { opacity: .5; cursor: default; }
.hero-foot { background: rgba(0,0,0,.35); backdrop-filter: blur(4px); }
.tabs { display: flex; list-style: none; margin: 0; padding: 0 max(16px, env(safe-area-inset-left, 0px)) 0 max(16px, env(safe-area-inset-right, 0px)); overflow-x: auto; }
.tabs li { flex: 1 0 auto; text-align: center; }
.tabs a { display: block; color: #fff; padding: .9rem 1rem; border: 1px solid rgba(255,255,255,.25); border-bottom: 0; border-radius: 6px 6px 0 0; margin-top: .5rem; font-size: 1.05rem; white-space: nowrap; }
.tabs a:hover { background: rgba(255,255,255,.15); text-decoration: none; }
.badge { position: absolute; z-index: 3; left: max(16px, env(safe-area-inset-left, 0px)); bottom: 4.2rem; background: var(--ph-bg); color: var(--ph-fg); border: 1.5px dashed var(--ph-line); border-radius: 8px; padding: .5rem .75rem; font-size: .8rem; max-width: 22rem; line-height: 1.35; }
.badge b { display: block; text-transform: uppercase; letter-spacing: .06em; font-size: .7rem; }

/* Sections */
.section { padding-block: 3.5rem; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.section.is-medium { padding-block: 5rem; }
.section.is-small { padding-block: 2.5rem; }
.container { max-width: 960px; margin-inline: auto; min-width: 0; }
.narrow { max-width: 780px; margin-inline: auto; }
.title { font-size: clamp(1.7rem, 4vw, 3rem); font-weight: 600; text-align: center; margin-bottom: 1.5rem; line-height: 1.15; }
.title.is-3 { font-size: clamp(1.4rem, 3vw, 2rem); }
.title.left { text-align: left; }
.subtitle { font-size: clamp(1.15rem, 2.2vw, 1.5rem); line-height: 1.5; font-weight: 400; text-align: justify; }
.subtitle b { font-weight: 700; }
.content { font-size: 1.05rem; text-align: justify; }
.content p { margin: 0 0 1rem; }
.content p:last-child { margin-bottom: 0; }
.caption { font-size: .9rem; color: var(--fg-muted); text-align: left; margin-top: .6rem; line-height: 1.5; }
.caption b { color: var(--fg); }
.media { border-radius: 20px; overflow: hidden; background: #000; }
.media.light { background: var(--box); }
.media video, .media img { width: 100%; }
.stack { display: flex; flex-direction: column; gap: 1.5rem; }
.band { background: var(--band); color: var(--band-fg); }
.band .title { color: #fff; }
.band .caption { color: #cfcfcf; }
.band .caption b { color: #fff; }
.band .frame { border: 1px solid rgba(255,255,255,.18); border-radius: 12px; padding: .9rem; }
.band .frame img { border-radius: 8px; background: #fff; }
.grid { display: grid; gap: 1rem; }
.grid.four { grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
.grid.two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
.grid.three { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
.tile { min-width: 0; }
.tile .label { font-family: var(--font-title); font-weight: 600; font-size: 1.05rem; margin-bottom: .4rem; display: flex; align-items: center; gap: .5rem; }
.tile .label i { width: .8rem; height: .8rem; border-radius: 2px; display: inline-block; }
.tile .media { border-radius: 12px; }
.tile .how { font-size: .9rem; color: var(--fg-muted); margin-top: .4rem; line-height: 1.45; }
.finding { background: #eef3fb; border: 1px solid #c9d8ef; border-radius: 10px; padding: 1rem 1.2rem; font-style: italic; margin-top: 1.2rem; }
.finding b { font-style: normal; color: #1f4f9a; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: 1rem; text-align: center; margin: 2rem 0; }
.stat { background: var(--box); border-radius: 12px; padding: 1.1rem .5rem; }
.stat .n { font-family: var(--font-title); font-size: 2.2rem; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.stat .l { font-size: .85rem; color: var(--fg-muted); margin-top: .4rem; }
.task { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 2rem; align-items: start; margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
.task:first-of-type { border-top: 0; padding-top: 0; }
.task h3 { font-size: 1.5rem; font-weight: 600; margin-bottom: .6rem; }
.task .eyebrow { font-size: .78rem; letter-spacing: .09em; text-transform: uppercase; color: var(--fg-light); font-weight: 600; margin-bottom: .4rem; font-family: var(--font-title); }
.task .text { min-width: 0; }
.task .figs { min-width: 0; display: flex; flex-direction: column; gap: 1rem; }
.box { background: var(--bg); border-radius: 6px; box-shadow: 0 .5em 1em -.125em rgba(10,10,10,.1), 0 0 0 1px rgba(10,10,10,.02); padding: 3rem 2rem; }
.authors { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); gap: 1.5rem; text-align: center; margin-top: 1.5rem; }
.author .pic { width: 9rem; height: 9rem; margin: 0 auto .6rem; border-radius: 50%; }
.author .name { font-weight: 600; }
.author .role { font-size: .85rem; color: var(--fg-muted); }
pre { background: var(--box); border-radius: 8px; padding: 1rem 1.2rem; overflow-x: auto; font-family: var(--font-mono); font-size: .85rem; line-height: 1.5; margin: 1rem 0 0; }
.qa h3 { font-size: 1.2rem; font-weight: 600; margin: 1.6rem 0 .4rem; }
.qa h3:first-child { margin-top: 0; }
.footer { padding-block: 2.5rem; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); background: var(--box); text-align: center; font-size: .9rem; color: var(--fg-muted); }
.footer p { margin: .3rem 0; }

/* Placeholders for media still to be shot */
.ph { position: relative; width: 100%; max-width: 100%; border: 2px dashed var(--ph-line); border-radius: 12px; background: var(--ph-bg) repeating-linear-gradient(135deg, transparent 0 14px, rgba(199,121,42,.08) 14px 16px); color: var(--ph-fg); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 1rem; gap: .35rem; }
.ph .k { font-family: var(--font-title); text-transform: uppercase; letter-spacing: .09em; font-size: .72rem; font-weight: 700; }
.ph .w { font-size: .95rem; font-weight: 600; line-height: 1.35; max-width: 34rem; }
.ph .s { font-size: .8rem; font-family: var(--font-mono); opacity: .9; }
.ph.tall .w { font-size: .85rem; }
.band .ph { background-color: #1a1510; color: #f0c89a; border-color: #d89a4e; }
.checklist { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .6rem; }
.checklist li { display: grid; grid-template-columns: 2.2rem 1fr; gap: .6rem; align-items: start; background: var(--ph-bg); border: 1px dashed var(--ph-line); border-radius: 8px; padding: .7rem .9rem; font-size: .95rem; color: var(--ph-fg); }
.checklist .num { font-family: var(--font-title); font-weight: 700; }
.checklist .where { display: block; font-size: .8rem; opacity: .85; font-family: var(--font-mono); margin-top: .2rem; }
/* Rollouts, hardware, downloads */
.rollout { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--line); }
.rollout:first-of-type { margin-top: 1.5rem; padding-top: 0; border-top: 0; }
.rollout h3 { font-size: 1.25rem; font-weight: 600; margin-bottom: .2rem; }
.rollout .sub { font-size: .9rem; color: var(--fg-muted); margin: 0 0 .9rem; }
.pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
.pair .ph.ok { border-color: #2f8f4e; color: #1f5e34; background: #eefaf1 repeating-linear-gradient(135deg, transparent 0 14px, rgba(47,143,78,.08) 14px 16px); }
.pair .ph.bad { border-color: #c84b3a; color: #7a2619; background: #fdf0ee repeating-linear-gradient(135deg, transparent 0 14px, rgba(200,75,58,.08) 14px 16px); }
.pair .ph .k::before { content: ""; display: inline-block; width: .6rem; height: .6rem; border-radius: 50%; margin-right: .4rem; background: currentColor; vertical-align: middle; }
.hw { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
.hw .tile .ph { aspect-ratio: 4 / 3; }
.hw .tile .how { text-align: left; }
.hw .tile .media img, .hw .tile .media video { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
.clipw { margin: 0; min-width: 0; }
.clip { position: relative; border-radius: 12px; overflow: hidden; background: #000; }
.clip video { display: block; width: 100%; object-fit: cover; }
.clip .tag { position: absolute; top: .6rem; left: .6rem; z-index: 1; font-family: var(--font-title); font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .22rem .6rem; border-radius: 999px; color: #fff; background: rgba(0,0,0,.6); }
.clip .spd { position: absolute; top: .6rem; right: .6rem; z-index: 1; font-family: var(--font-title); font-size: .7rem; font-weight: 700; padding: .22rem .5rem; border-radius: 999px; color: #111; background: rgba(255,255,255,.85); }
.clipw.ok .tag { background: #2f8f4e; }
.clipw.bad .tag { background: #c84b3a; }
.clipw figcaption { font-size: .85rem; color: var(--fg-muted); line-height: 1.4; margin: .45rem .15rem 0; }
.band .clipw figcaption { color: rgba(245,245,245,.78); }
.quad { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
.quad .clip video { aspect-ratio: 4 / 3; }
.standin { display: block; font-size: .78rem; line-height: 1.35; color: var(--ph-fg); background: var(--ph-bg); border: 1px dashed var(--ph-line); border-radius: 8px; padding: .4rem .65rem; margin-top: .55rem; }
.standin b { font-family: var(--font-title); text-transform: uppercase; letter-spacing: .07em; font-size: .68rem; margin-right: .3rem; }
.band .standin { background: #1a1510; color: #f0c89a; border-color: #d89a4e; }
.spec { display: grid; grid-template-columns: max-content 1fr; gap: .3rem 1rem; font-size: .95rem; margin-top: 1.2rem; }
.spec dt { color: var(--fg-light); }
.spec dd { margin: 0; }
.tablebox { overflow-x: auto; margin-top: 1.5rem; }
table.dl { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 48rem; }
table.dl th { text-align: left; font-family: var(--font-title); font-weight: 600; padding: .6rem .6rem; border-bottom: 2px solid var(--fg); white-space: nowrap; }
table.dl td { text-align: left; padding: .7rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
table.dl td.n { font-variant-numeric: tabular-nums; white-space: nowrap; }
table.dl .btn { padding: .25rem .75rem; font-size: .8rem; margin: .1rem .2rem .1rem 0; }
.dlnote { font-size: .9rem; color: var(--fg-muted); margin-top: .8rem; }
/* Side legend */
.legend { position: fixed; left: 1.1rem; top: 50%; transform: translateY(-50%); z-index: 20; background: rgba(255,255,255,.88); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(0,0,0,.08); border-radius: 14px; padding: .55rem .4rem; box-shadow: 0 6px 24px rgba(0,0,0,.12); }
.legend ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .1rem; }
.legend a { display: flex; align-items: center; gap: .55rem; color: var(--fg-muted); font-family: var(--font-title); font-size: .78rem; font-weight: 500; line-height: 1.2; padding: .28rem .5rem; border-radius: 8px; white-space: nowrap; }
.legend a::before { content: ""; flex: 0 0 auto; width: .5rem; height: .5rem; border-radius: 50%; background: var(--line); transition: background .2s, transform .2s; }
.legend a:hover { text-decoration: none; background: rgba(0,0,0,.05); color: var(--fg); }
.legend a.is-active { color: var(--fg); font-weight: 700; }
.legend li.ext { border-top: 1px solid rgba(0,0,0,.08); margin-top: .25rem; padding-top: .25rem; }
.legend li.ext a::before { background: var(--accent); }
.legend a.is-active::before { background: #c84b3a; transform: scale(1.3); }
@media (max-width: 1240px) { .legend a { font-size: 0; gap: 0; padding: .3rem .35rem; } .legend a::before { width: .6rem; height: .6rem; } .legend { padding: .5rem .35rem; } .legend a:hover { font-size: .78rem; gap: .55rem; } }
@media (max-width: 900px) { .legend { display: none; } }
.subsec { margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
.subtitle-h { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 600; text-align: center; margin-bottom: 1.2rem; }
.warn { background: #fdecea; border: 1px solid #f1b2aa; border-left: 5px solid #c84b3a; border-radius: 10px; padding: .8rem 1rem; color: #7a2619; font-size: .98rem; line-height: 1.5; margin-top: 1.2rem; }
.warn b { display: block; font-family: var(--font-title); font-size: 1.05rem; margin-bottom: .2rem; }
/* Questions, answers, takeaways, isolating experiments */
.q { background: #fdecea; border: 1px solid #f1b2aa; border-left: 5px solid #c84b3a; border-radius: 10px; padding: .7rem 1rem; color: #7a2619; font-family: var(--font-title); font-weight: 600; font-size: 1.12rem; line-height: 1.35; margin-bottom: .9rem; text-align: left; }
.q .qk { display: block; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; opacity: .8; margin-bottom: .15rem; }
.answer { font-size: 1.05rem; line-height: 1.45; margin: .6rem 0 1rem; padding: .6rem .9rem; background: #eef3fb; border-left: 4px solid #1f4f9a; border-radius: 0 8px 8px 0; text-align: left; }
.answer b { color: #1f4f9a; }
.task .eyebrow { margin-bottom: .2rem; }
.takeaways { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; }
.tk { background: var(--box); border-radius: 14px; padding: 1.2rem 1.3rem; border-top: 5px solid #c84b3a; }
.tk-n { font-family: var(--font-title); font-size: 1rem; font-weight: 700; line-height: 1; width: 2rem; height: 2rem; border-radius: 50%; background: #c84b3a; color: #fff; display: inline-flex; align-items: center; justify-content: center; }
.tk-n small { font-size: 1rem; font-weight: 400; color: var(--fg-light); margin: 0 .1rem; }
.tk-h { font-family: var(--font-title); font-weight: 600; font-size: 1.3rem; margin: .7rem 0 .4rem; line-height: 1.25; }
.tk-t { font-size: .92rem; color: var(--fg-muted); line-height: 1.5; }
.iso { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }
.iso-head { max-width: 780px; margin: 0 auto 1.5rem; }
.iso-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; align-items: start; }
.iso-col { min-width: 0; background: var(--box); border-radius: 14px; padding: 1.1rem 1.1rem 1.2rem; }
.iso-col h3 { font-size: 1.2rem; font-weight: 600; margin: .3rem 0 .3rem; }
.iso-tag { display: inline-block; font-family: var(--font-title); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: #c84b3a; border-radius: 999px; padding: .2rem .65rem; }
.iso-col .answer { font-size: .95rem; margin: .5rem 0 .9rem; }
.iso-col .figs { display: flex; flex-direction: column; gap: .8rem; margin-bottom: .9rem; }
.rl-link { text-align: center; margin: -.5rem 0 1.8rem; }
.task .chart-row { grid-column: 1 / -1; }
.iso-col .chart-row { margin-bottom: .9rem; }
.chart { border-radius: 12px; border: 1px solid var(--line); background: #fff; }
.chart video { display: block; width: 100%; }
.iso-col .content { font-size: .92rem; text-align: left; }
.iso-col .quad { grid-template-columns: 1fr 1fr; }
.iso-col .pair { grid-template-columns: 1fr; }
.iso-col .caption { font-size: .82rem; }
.iso-col .clipw figcaption { font-size: .78rem; }
@media (max-width: 860px) { .iso-grid { grid-template-columns: 1fr; } }
/* Method viewer: one slide per task, tabs + horizontal snap scroll */
.her { margin-top: 1.5rem; }
.her-tabs { display: grid; grid-template-columns: repeat(6, 1fr); gap: .45rem; margin-bottom: .9rem; }
.her-tab { font: inherit; font-family: var(--font-title); font-weight: 600; font-size: .92rem; line-height: 1.15; color: var(--fg); background: var(--box); border: 1px solid var(--line); border-radius: 12px; padding: .5rem .45rem; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .2rem; min-width: 0; }
.her-tab small { font-family: var(--font-body); font-weight: 400; font-size: .68rem; line-height: 1.25; color: var(--fg-muted); }
.her-tab:hover { border-color: var(--fg-light); }
.her-tab.is-active { background: var(--dark-btn); color: #fff; border-color: var(--dark-btn); }
.her-tab.is-active small { color: #d8d8d8; }
.her-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 16px; outline-offset: 4px; }
.her-track::-webkit-scrollbar { display: none; }
.her-slide { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; scroll-snap-stop: always; padding: .9rem 1rem 1rem; background: var(--box); border-radius: 16px; }
.her-slide + .her-slide { margin-left: .75rem; }
.her-slide .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem; margin-bottom: .6rem; }
.her-slide h3 { font-size: 1.1rem; font-weight: 600; margin: 0; }
.her-slide .sub { font-size: .82rem; color: var(--fg-muted); margin: 0; }
.her-pair { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
.her-pair .clipw figcaption { font-size: .78rem; margin-top: .3rem; }
.her-pair .clip video { aspect-ratio: 16 / 9; }
.her-pair .ph { aspect-ratio: 16 / 9; }
.her-quad { display: grid; grid-template-columns: repeat(4, 1fr); gap: .6rem; margin-top: .8rem; --ar: 16 / 9; }
.her-quad .tile .label { font-size: .92rem; margin-bottom: .3rem; }
.her-quad .media video { aspect-ratio: var(--ar); object-fit: cover; }
.her-quad .ph { aspect-ratio: var(--ar); padding: .6rem; gap: .25rem; }
.her-quad .ph .w { font-size: .8rem; }
.her-quad .ph .s { font-size: .7rem; }
.her-quad .na { aspect-ratio: var(--ar); border: 1px solid var(--line); border-radius: 12px; background: #ececec; color: var(--fg-light); display: flex; align-items: center; justify-content: center; text-align: center; font-size: .82rem; line-height: 1.35; padding: .8rem; }
.her-slide .caption { margin-top: .6rem; font-size: .82rem; }
.her-nav { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: .7rem; }
.her-arrow { font: inherit; font-size: 1.1rem; line-height: 1; width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer; }
.her-arrow:hover { background: var(--box); }
.her-dots { display: flex; gap: .45rem; }
.her-dot { width: .6rem; height: .6rem; padding: 0; border-radius: 50%; border: 0; background: var(--line); cursor: pointer; }
.her-dot.is-active { background: var(--dark-btn); }
.her-legend { margin-top: 1.5rem; }
.her-legend .tile .how { margin-top: .2rem; }
.her-hint { text-align: center; font-size: .78rem; color: var(--fg-light); margin-top: .35rem; }
#viewer { padding-block: 2.5rem 2rem; }
#viewer .title { margin-bottom: .6rem; }
.her-intro { text-align: center; font-size: .95rem; color: var(--fg-muted); max-width: 44rem; margin: 0 auto 1rem; line-height: 1.5; }
@media (max-width: 760px) { .her-quad { grid-template-columns: 1fr 1fr; } .her-tabs { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 480px) { .her-tabs { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 520px) { .her-pair { grid-template-columns: 1fr; } .her-slide { padding: .8rem; } }
@media (prefers-reduced-motion: no-preference) { .her-track { scroll-behavior: smooth; } }
.author img.pic { object-fit: cover; }
@media (max-width: 640px) {
  .hero-head { justify-content: center; font-size: .95rem; }
  .tabs a { font-size: .9rem; padding: .7rem .6rem; }
  .badge { bottom: 4.6rem; max-width: 16rem; font-size: .72rem; }
  .box { padding: 2rem 1.2rem; }
}
@media (prefers-reduced-motion: reduce) { .hero-video video { display: none; } .hero-video { background: #222 url("hero_poster.jpg") center/cover; } }
